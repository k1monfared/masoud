---
import { site, bookingHref } from '../data/site';
---
{/* TODO(copy): review tagline and pitch wording. */}
<section class="hero">
  <div class="hero__inner">
    <div class="hero__text">
      <p class="hero__eyebrow">Licensed RCIC. Canada-wide service.</p>
      <h1 class="hero__title">{site.tagline}</h1>
      <p class="hero__sub">{site.subTagline}</p>
      <div class="hero__actions">
        <a class="hero__cta" href={bookingHref}>Book a free consultation</a>
        <a class="hero__link" href="#services">See services ↓</a>
      </div>
    </div>
    <div class="hero__art" aria-hidden="true">
      <div class="hero__art-circle">
        <div class="hero__art-photo">
          <span>Your photo</span>
        </div>
      </div>
      <div class="hero__art-glow"></div>
    </div>
  </div>
</section>

<style>
  .hero {
    margin: 0 calc(var(--space-4) * -1) var(--space-7);
    padding: var(--space-7) var(--space-4) var(--space-6);
    background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-bg) 100%);
    border-bottom: 1px solid var(--color-border);
  }
  .hero__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    align-items: center;
  }
  .hero__text { text-align: center; max-width: 36ch; }
  .hero__eyebrow {
    color: var(--color-primary);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 600;
    margin: 0 0 var(--space-3) 0;
  }
  .hero__title {
    font-size: 2rem;
    line-height: 1.15;
    color: var(--color-text);
    margin: 0 0 var(--space-3) 0;
    font-weight: 600;
  }
  .hero__sub {
    color: var(--color-text-muted);
    margin: 0 auto var(--space-5);
    line-height: 1.6;
  }
  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: center;
  }
  .hero__cta {
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-pill);
    font-weight: 600;
    min-height: var(--tap-target);
    display: inline-flex;
    align-items: center;
    box-shadow: 0 4px 12px rgba(168, 118, 72, 0.25);
  }
  .hero__cta:hover { text-decoration: none; background: var(--color-primary-strong); }
  .hero__link {
    color: var(--color-primary);
    padding: var(--space-2);
    font-weight: 600;
    border-bottom: 1px dashed var(--color-primary);
  }
  .hero__link:hover { text-decoration: none; }

  .hero__art {
    position: relative;
    width: 220px;
    height: 220px;
    flex-shrink: 0;
  }
  .hero__art-circle {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    overflow: hidden;
  }
  .hero__art-photo {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-style: italic;
  }
  .hero__art-glow {
    position: absolute;
    inset: -20px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(168, 118, 72, 0.12), transparent 70%);
    z-index: -1;
  }

  @media (min-width: 720px) {
    .hero { padding: var(--space-7) var(--space-4) calc(var(--space-7) * 1.25); }
    .hero__inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-7);
    }
    .hero__text { text-align: left; flex: 1; max-width: 540px; }
    .hero__sub { margin-left: 0; margin-right: 0; }
    .hero__actions { flex-direction: row; gap: var(--space-4); }
    .hero__title { font-size: 2.75rem; }
    .hero__art { width: 320px; height: 320px; }
  }
</style>
