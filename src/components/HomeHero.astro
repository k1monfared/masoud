---
import { site, bookingHref } from '../data/site';
---
{/* TODO(copy): review tagline and pitch wording. */}
<section class="hero">
  <div class="hero__inner">
    <p class="hero__eyebrow">Licensed RCIC. Based in Victoria, BC.</p>
    <h1 class="hero__title">{site.tagline}</h1>
    <p class="hero__sub">{site.subTagline}</p>
    <div class="hero__actions">
      <a class="hero__cta" href={bookingHref}>Book a free consultation</a>
      <a class="hero__link" href="#services">See services ↓</a>
    </div>
  </div>
</section>

<style>
  .hero {
    margin: 0 calc(var(--space-4) * -1) var(--space-7);
    padding: var(--space-7) var(--space-4);
    background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-bg) 100%);
    border-bottom: 1px solid var(--color-border);
    text-align: center;
  }
  .hero__inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .hero__eyebrow {
    color: var(--color-primary);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 600;
    margin: 0 0 var(--space-3) 0;
  }
  .hero__title {
    font-size: 2.1rem;
    line-height: 1.15;
    color: var(--color-text);
    margin: 0 auto var(--space-3);
    font-weight: 600;
    max-width: 18ch;
  }
  .hero__sub {
    color: var(--color-text-muted);
    margin: 0 auto var(--space-5);
    line-height: 1.6;
    max-width: 48ch;
  }
  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: center;
  }
  .hero__cta {
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-pill);
    font-weight: 600;
    min-height: var(--tap-target);
    display: inline-flex;
    align-items: center;
    box-shadow: 0 4px 12px rgba(168, 118, 72, 0.25);
  }
  .hero__cta:hover { text-decoration: none; background: var(--color-primary-strong); }
  .hero__link {
    color: var(--color-primary);
    padding: var(--space-2);
    font-weight: 600;
    border-bottom: 1px dashed var(--color-primary);
  }
  .hero__link:hover { text-decoration: none; }

  @media (min-width: 720px) {
    .hero { padding: calc(var(--space-7) * 1.5) var(--space-4); }
    .hero__title { font-size: 3rem; }
    .hero__actions { flex-direction: row; justify-content: center; gap: var(--space-4); }
  }
</style>
