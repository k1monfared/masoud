---
import { site, bookingHref } from '../data/site';
---
{/* TODO(copy): review tagline and pitch wording. */}
<section class="hero">
  <div class="hero__inner">
    <h1 class="hero__title">{site.tagline}</h1>
    <p class="hero__sub">{site.subTagline}</p>
    <div class="hero__actions">
      <a class="hero__cta" href={bookingHref}>Book a free consultation</a>
      <a class="hero__link" href="#services">See services ↓</a>
    </div>
  </div>
</section>

<style>
  .hero {
    margin-top: calc(var(--space-5) * -1);
    margin-bottom: var(--space-6);
    padding: var(--space-7) 0 var(--space-6);
    background: linear-gradient(180deg, var(--color-surface-2), transparent);
  }
  .hero__inner { text-align: center; }
  .hero__title {
    font-size: 1.85rem;
    line-height: 1.2;
    color: var(--color-primary);
    margin: 0 0 var(--space-3) 0;
  }
  .hero__sub {
    color: var(--color-text-muted);
    margin: 0 auto var(--space-5);
    max-width: 36ch;
  }
  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: center;
  }
  .hero__cta {
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    padding: var(--space-3) var(--space-5);
    border-radius: 999px;
    font-weight: 600;
    min-height: var(--tap-target);
    display: inline-flex;
    align-items: center;
  }
  .hero__cta:hover { text-decoration: none; opacity: 0.95; }
  .hero__link {
    color: var(--color-primary);
    padding: var(--space-2);
    font-weight: 600;
  }
  @media (min-width: 720px) {
    .hero__title { font-size: 2.4rem; }
    .hero__actions { flex-direction: row; justify-content: center; gap: var(--space-3); }
  }
</style>
