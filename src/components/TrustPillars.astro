---
import { site } from '../data/site';
---
{/* TODO(copy): adjust pillar wording once experience numbers and language list are confirmed. */}
<section class="pillars">
  <p class="pillars__eyebrow">Unique Merger Of Legal Insight and Personal Care</p>
  <h2 class="pillars__heading">Why work with me</h2>
  <div class="pillars__grid">
    <article class="pillar">
      <div class="pillar__icon" aria-hidden="true">⚖️</div>
      <h3 class="pillar__title">Licensed RCIC</h3>
      <p class="pillar__body">
        Regulated Canadian Immigration Consultant, license #{site.rcicLicense}. Bound by the College of Immigration and Citizenship Consultants Code of Conduct.
      </p>
    </article>
    <article class="pillar">
      <div class="pillar__icon" aria-hidden="true">🗣️</div>
      <h3 class="pillar__title">Languages</h3>
      <p class="pillar__body">
        I work in {site.languages.join(', ')}. We discuss your case in the language you think in.
      </p>
    </article>
    <article class="pillar">
      <div class="pillar__icon" aria-hidden="true">📈</div>
      <h3 class="pillar__title">Experience</h3>
      <p class="pillar__body">
        {site.yearsExperience}+ years guiding {site.clientsServed}+ clients through Canadian immigration. Plain-English explanations at every step.
      </p>
    </article>
  </div>
</section>

<style>
  .pillars { margin: var(--space-7) auto; max-width: 960px; text-align: center; }
  .pillars__eyebrow {
    color: var(--color-primary);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 600;
    margin: 0 0 var(--space-2) 0;
  }
  .pillars__heading {
    font-size: 2rem;
    color: var(--color-text);
    margin: 0 0 var(--space-6) 0;
    font-weight: 600;
  }
  .pillars__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    text-align: center;
  }
  @media (min-width: 720px) {
    .pillars__heading { font-size: 2.25rem; }
    .pillars__grid { grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }
  }
  .pillar {
    padding: var(--space-4);
  }
  .pillar__icon {
    font-size: 36px;
    margin-bottom: var(--space-3);
    line-height: 1;
  }
  .pillar__title {
    font-size: 1.25rem;
    color: var(--color-text);
    margin: 0 0 var(--space-2) 0;
    font-weight: 600;
  }
  .pillar__body { margin: 0; color: var(--color-text-muted); line-height: 1.6; }
</style>
