---
import { getCollection } from 'astro:content';
import { site, bookingHref } from '../data/site';

const goals = (await getCollection('goals')).sort((a, b) => a.data.order - b.data.order);
---
<header class="topnav">
  <div class="container topnav__inner">
    <a class="topnav__brand" href="/">{site.firmName}</a>

    <nav class="topnav__desktop" aria-label="Primary">
      <details class="topnav__dd">
        <summary class="topnav__link">Services</summary>
        <div class="topnav__menu">
          {goals.map(g => (
            <a class="topnav__menulink" href={`/${g.slug}`}>
              <span aria-hidden="true">{g.data.icon}</span>
              <span>{g.data.title}</span>
            </a>
          ))}
        </div>
      </details>
      <a class="topnav__link" href="/about">About</a>
      <a class="topnav__link" href="/resources">Resources</a>
      <a class="topnav__pill" href={bookingHref}>Book consultation</a>
    </nav>

    <button class="topnav__ham" aria-controls="sitemenu" aria-expanded="false" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav id="sitemenu" class="drawer" hidden aria-label="Site menu">
    <p class="drawer__heading">Services</p>
    <ul class="drawer__list">
      {goals.map(g => (
        <li><a href={`/${g.slug}`}>{g.data.title}</a></li>
      ))}
    </ul>
    <p class="drawer__heading">More</p>
    <ul class="drawer__list">
      <li><a href="/about">About</a></li>
      <li><a href="/resources">Resources</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
    <div class="drawer__cta">
      <a class="topnav__pill topnav__pill--full" href={bookingHref}>Book consultation</a>
    </div>
  </nav>
</header>

<style>
  .topnav { background: var(--color-primary); color: var(--color-primary-contrast); position: relative; }
  .topnav__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); min-height: var(--tap-target); }
  .topnav__brand { color: inherit; font-weight: 700; }

  .topnav__desktop { display: none; }
  @media (min-width: 720px) {
    .topnav__desktop { display: flex; align-items: center; gap: var(--space-3); }
    .topnav__ham { display: none !important; }
  }

  .topnav__link {
    color: inherit;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    cursor: pointer;
    list-style: none;
  }
  .topnav__link::-webkit-details-marker { display: none; }
  .topnav__link:hover { background: rgba(255,255,255,0.08); text-decoration: none; }

  .topnav__pill {
    background: var(--color-primary-contrast);
    color: var(--color-primary);
    padding: var(--space-2) var(--space-4);
    border-radius: 999px;
    font-weight: 600;
    margin-left: var(--space-2);
  }
  .topnav__pill:hover { text-decoration: none; opacity: 0.95; }
  .topnav__pill--full { display: block; text-align: center; margin: 0; }

  .topnav__dd { position: relative; }
  .topnav__dd[open] > .topnav__link { background: rgba(255,255,255,0.12); }
  .topnav__menu {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 4px;
    min-width: 240px;
    background: var(--color-primary-contrast);
    color: var(--color-text);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgba(0,0,0,0.18);
    padding: var(--space-2);
    display: flex;
    flex-direction: column;
    z-index: 10;
  }
  .topnav__menulink {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    color: var(--color-text);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
  }
  .topnav__menulink:hover { background: var(--color-surface-2); text-decoration: none; }

  .topnav__ham {
    background: transparent; border: 0; color: inherit;
    width: var(--tap-target); height: var(--tap-target);
    display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px;
  }
  .topnav__ham span { display: block; width: 22px; height: 2px; background: currentColor; }

  .drawer { background: var(--color-primary); padding: var(--space-3) var(--space-4) var(--space-4); }
  .drawer[hidden] { display: none; }
  @media (min-width: 720px) {
    .drawer { display: none !important; }
  }
  .drawer__heading {
    margin: var(--space-3) 0 var(--space-1) 0;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    opacity: 0.75;
  }
  .drawer__heading:first-child { margin-top: 0; }
  .drawer__list { list-style: none; margin: 0; padding: 0; }
  .drawer__list li a {
    display: block; padding: var(--space-3) var(--space-2); min-height: var(--tap-target);
    color: var(--color-primary-contrast);
    border-radius: var(--radius);
  }
  .drawer__list li a:hover { background: rgba(255,255,255,0.08); text-decoration: none; }
  .drawer__cta { margin-top: var(--space-4); }
</style>

<script>
  // Hamburger toggle
  const btn = document.querySelector('.topnav__ham');
  const menu = document.getElementById('sitemenu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const open = !menu.hasAttribute('hidden');
      if (open) {
        menu.setAttribute('hidden', '');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        menu.removeAttribute('hidden');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  }

  // Close Services dropdown when clicking outside
  const dd = document.querySelector('.topnav__dd');
  if (dd) {
    document.addEventListener('click', (e) => {
      if (!dd.contains(e.target as Node)) {
        (dd as HTMLDetailsElement).open = false;
      }
    });
  }
</script>
