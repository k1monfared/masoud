---
import { getCollection } from 'astro:content';
import { path } from '../lib/path';
import Icon from './Icon.astro';

const goals = (await getCollection('goals')).sort((a, b) => a.data.order - b.data.order);
---
<header class="topnav">
  <div class="container topnav__inner">
    <a class="topnav__brand" href={path('/')} aria-label="Manzouri Immigration, home">
      <span class="topnav__brand-mark">Manzouri</span>
      <span class="topnav__brand-sub" aria-hidden="true">
        <span>I</span><span>M</span><span>M</span><span>I</span><span>G</span><span>R</span><span>A</span><span>T</span><span>I</span><span>O</span><span>N</span>
      </span>
    </a>

    <nav class="topnav__desktop" aria-label="Primary">
      <details class="topnav__dd">
        <summary class="topnav__link">Services</summary>
        <div class="topnav__menu">
          {goals.map(g => (
            <a class="topnav__menulink" href={path(`/${g.slug}`)}>
              <Icon name={g.data.icon} size={18} strokeWidth={1.5} class="topnav__menuicon" />
              <span>{g.data.title}</span>
            </a>
          ))}
        </div>
      </details>
      <a class="topnav__link" href={path('/about')}>About</a>
      <a class="topnav__link" href={path('/resources')}>Resources</a>
      <a class="topnav__link" href={path('/contact')}>Contact</a>
    </nav>

    <button class="topnav__ham" aria-controls="sitemenu" aria-expanded="false" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="drawer-backdrop" hidden aria-hidden="true"></div>

  <nav id="sitemenu" class="drawer" hidden aria-label="Site menu">
    <div class="drawer__head">
      <span class="drawer__title">Menu</span>
      <button class="drawer__close" aria-label="Close menu">
        <span></span><span></span>
      </button>
    </div>

    <details class="drawer__group">
      <summary class="drawer__summary">
        <span>Services</span>
        <Icon name="chevron-down" size={18} strokeWidth={2} class="drawer__chev" />
      </summary>
      <ul class="drawer__list">
        {goals.map(g => (
          <li><a href={path(`/${g.slug}`)}>{g.data.title}</a></li>
        ))}
      </ul>
    </details>

    <ul class="drawer__list drawer__list--top">
      <li><a href={path('/about')}>About</a></li>
      <li><a href={path('/resources')}>Resources</a></li>
      <li><a href={path('/contact')}>Contact</a></li>
    </ul>
  </nav>
</header>

<style>
  .topnav {
    background: var(--color-nav-bg);
    color: var(--color-nav-text);
    position: sticky;
    top: 0;
    z-index: 50;
    transition: box-shadow 200ms ease;
  }
  .topnav.is-scrolled {
    box-shadow: 0 4px 14px rgba(44, 58, 78, 0.08);
  }
  .topnav__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); min-height: 80px; padding: var(--space-3) 0; }
  .topnav__brand {
    color: inherit;
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
    gap: 2px;
  }
  .topnav__brand:hover { text-decoration: none; }
  .topnav__brand-mark {
    font-family: var(--font-brand);
    font-weight: 900;
    font-size: 1.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text);
    margin-right: -0.18em;
  }
  .topnav__brand-sub {
    font-family: var(--font-brand);
    font-weight: 400;
    font-size: 0.78rem;
    text-transform: uppercase;
    color: var(--color-text-muted);
    display: flex;
    justify-content: space-between;
    width: 100%;
  }
  .topnav__brand-sub span { display: inline-block; }
  @media (min-width: 720px) {
    .topnav__brand-mark { font-size: 1.85rem; }
  }

  .topnav__desktop { display: none; }
  @media (min-width: 720px) {
    .topnav__desktop { display: flex; align-items: center; gap: var(--space-2); }
    .topnav__ham { display: none !important; }
  }

  .topnav__link {
    color: inherit;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    cursor: pointer;
    list-style: none;
    font-size: 0.95rem;
  }
  .topnav__link::-webkit-details-marker { display: none; }
  .topnav__link:hover { background: var(--color-surface-2); text-decoration: none; }

  .topnav__pill {
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-pill);
    font-weight: 600;
    margin-left: var(--space-3);
    font-size: 0.95rem;
  }
  .topnav__pill:hover { text-decoration: none; background: var(--color-primary-strong); }
  .topnav__pill--full { display: block; text-align: center; margin: 0; }

  .topnav__dd { position: relative; }
  .topnav__dd[open] > .topnav__link { background: var(--color-surface-2); }
  .topnav__menu {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 4px;
    min-width: 260px;
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: 0 12px 28px rgba(44, 58, 78, 0.12);
    padding: var(--space-2);
    display: flex;
    flex-direction: column;
    z-index: 10;
  }
  .topnav__menulink {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    color: var(--color-text);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    font-size: 0.95rem;
  }
  .topnav__menuicon { color: var(--color-primary); flex-shrink: 0; }
  .topnav__menulink:hover { background: var(--color-bg); text-decoration: none; }

  .topnav__ham {
    background: transparent; border: 0; color: inherit;
    width: var(--tap-target); height: var(--tap-target);
    display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px;
  }
  .topnav__ham span { display: block; width: 22px; height: 2px; background: currentColor; }

  .drawer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(20, 48, 77, 0.45);
    z-index: 60;
    opacity: 0;
    transition: opacity 220ms ease;
  }
  .drawer-backdrop.is-visible { opacity: 1; }
  @media (min-width: 720px) {
    .drawer-backdrop { display: none !important; }
  }

  .drawer {
    position: fixed;
    top: 80px;
    right: var(--space-3);
    width: 85%;
    max-width: 360px;
    max-height: calc(100vh - 80px - var(--space-4));
    background: var(--color-surface);
    z-index: 70;
    padding: var(--space-2) var(--space-4) var(--space-3);
    overflow-y: auto;
    transform: translateX(calc(100% + var(--space-3)));
    transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: 0 12px 28px rgba(20, 48, 77, 0.22);
  }
  .drawer.is-open { transform: translateX(0); }
  .drawer[hidden] { display: none; }
  @media (min-width: 720px) {
    .drawer { display: none !important; }
  }

  .drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) 0 var(--space-3);
  }
  .drawer__title {
    font-family: var(--font-brand);
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-text-muted);
  }
  .drawer__close {
    background: transparent;
    border: 0;
    width: var(--tap-target);
    height: var(--tap-target);
    position: relative;
    cursor: pointer;
  }
  .drawer__close span {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18px;
    height: 2px;
    background: currentColor;
    transform-origin: center;
  }
  .drawer__close span:first-child { transform: translate(-50%, -50%) rotate(45deg); }
  .drawer__close span:last-child { transform: translate(-50%, -50%) rotate(-45deg); }

  .drawer__group {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin: 0;
  }
  .drawer__summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-2);
    min-height: var(--tap-target);
    font-weight: 700;
    color: var(--color-text);
    font-size: 1rem;
  }
  .drawer__summary::-webkit-details-marker { display: none; }
  .drawer__chev { color: var(--color-text-muted); transition: transform 200ms ease; }
  .drawer__group[open] .drawer__chev { transform: rotate(180deg); }

  .drawer__list { list-style: none; margin: 0; padding: 0; }
  .drawer__group .drawer__list { padding: 0 0 var(--space-2); }
  .drawer__group .drawer__list li a {
    padding-left: var(--space-4);
    color: var(--color-text-muted);
  }
  .drawer__list--top { padding-top: 0; }
  .drawer__list li a {
    display: block;
    padding: var(--space-2) var(--space-2);
    min-height: 38px;
    color: var(--color-text);
    border-radius: var(--radius);
    font-size: 0.95rem;
    line-height: 1.3;
  }
  .drawer__list li a:hover { background: var(--color-bg); text-decoration: none; }

  .drawer__cta { margin-top: var(--space-4); }

  body.is-menu-open { overflow: hidden; }
</style>

<script>
  // Sticky nav scroll shadow
  const topnav = document.querySelector('.topnav');
  if (topnav) {
    const setScrolled = () => {
      if (window.scrollY > 4) topnav.classList.add('is-scrolled');
      else topnav.classList.remove('is-scrolled');
    };
    setScrolled();
    window.addEventListener('scroll', setScrolled, { passive: true });
  }

  // Mobile drawer
  const ham = document.querySelector('.topnav__ham') as HTMLButtonElement | null;
  const drawer = document.getElementById('sitemenu') as HTMLElement | null;
  const closeBtn = document.querySelector('.drawer__close') as HTMLButtonElement | null;
  const backdrop = document.querySelector('.drawer-backdrop') as HTMLElement | null;

  let menuOpen = false;

  function openMenu() {
    if (!drawer || !backdrop || menuOpen) return;
    menuOpen = true;
    drawer.removeAttribute('hidden');
    backdrop.removeAttribute('hidden');
    requestAnimationFrame(() => {
      drawer.classList.add('is-open');
      backdrop.classList.add('is-visible');
    });
    ham?.setAttribute('aria-expanded', 'true');
    document.body.classList.add('is-menu-open');
    history.pushState({ menuOpen: true }, '');
  }

  function closeMenu(viaPop = false) {
    if (!drawer || !backdrop || !menuOpen) return;
    menuOpen = false;
    drawer.classList.remove('is-open');
    backdrop.classList.remove('is-visible');
    ham?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('is-menu-open');
    setTimeout(() => {
      if (!menuOpen) {
        drawer.setAttribute('hidden', '');
        backdrop.setAttribute('hidden', '');
      }
    }, 280);
    if (!viaPop && history.state && (history.state as { menuOpen?: boolean }).menuOpen) {
      history.back();
    }
  }

  if (ham && drawer) {
    ham.addEventListener('click', () => {
      if (menuOpen) closeMenu();
      else openMenu();
    });
  }
  if (closeBtn) closeBtn.addEventListener('click', () => closeMenu());
  if (backdrop) backdrop.addEventListener('click', () => closeMenu());

  window.addEventListener('popstate', () => {
    if (menuOpen) closeMenu(true);
  });

  // Close menu when a link inside is tapped
  drawer?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      if (menuOpen) closeMenu();
    });
  });

  // Desktop Services dropdown: close on outside click
  const dd = document.querySelector('.topnav__dd');
  if (dd) {
    document.addEventListener('click', (e) => {
      if (!dd.contains(e.target as Node)) {
        (dd as HTMLDetailsElement).open = false;
      }
    });
  }
</script>
