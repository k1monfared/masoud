---
import { getCollection } from 'astro:content';
import { bookingHref } from '../data/site';
import { path } from '../lib/path';
import Icon from './Icon.astro';

const goals = (await getCollection('goals')).sort((a, b) => a.data.order - b.data.order);
---
<header class="topnav">
  <div class="container topnav__inner">
    <a class="topnav__brand" href={path('/')} aria-label="Manzouri Immigration, home">
      <span class="topnav__brand-mark">Manzouri</span>
      <span class="topnav__brand-sub">Immigration</span>
    </a>

    <nav class="topnav__desktop" aria-label="Primary">
      <details class="topnav__dd">
        <summary class="topnav__link">Services</summary>
        <div class="topnav__menu">
          {goals.map(g => (
            <a class="topnav__menulink" href={path(`/${g.slug}`)}>
              <Icon name={g.data.icon} size={18} strokeWidth={1.5} class="topnav__menuicon" />
              <span>{g.data.title}</span>
            </a>
          ))}
        </div>
      </details>
      <a class="topnav__link" href={path('/about')}>About</a>
      <a class="topnav__link" href={path('/resources')}>Resources</a>
      <a class="topnav__link" href={path('/contact')}>Contact</a>
      <a class="topnav__pill" href={bookingHref}>Book consultation</a>
    </nav>

    <button class="topnav__ham" aria-controls="sitemenu" aria-expanded="false" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav id="sitemenu" class="drawer" hidden aria-label="Site menu">
    <p class="drawer__heading">Services</p>
    <ul class="drawer__list">
      {goals.map(g => (
        <li><a href={path(`/${g.slug}`)}>{g.data.title}</a></li>
      ))}
    </ul>
    <p class="drawer__heading">More</p>
    <ul class="drawer__list">
      <li><a href={path('/about')}>About</a></li>
      <li><a href={path('/resources')}>Resources</a></li>
      <li><a href={path('/contact')}>Contact</a></li>
    </ul>
    <div class="drawer__cta">
      <a class="topnav__pill topnav__pill--full" href={bookingHref}>Book consultation</a>
    </div>
  </nav>
</header>

<style>
  .topnav {
    background: var(--color-nav-bg);
    color: var(--color-nav-text);
    position: sticky;
    top: 0;
    z-index: 50;
    transition: box-shadow 200ms ease;
  }
  .topnav.is-scrolled {
    box-shadow: 0 4px 14px rgba(44, 58, 78, 0.08);
  }
  .topnav__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); min-height: 80px; padding: var(--space-3) 0; }
  .topnav__brand {
    color: inherit;
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
    gap: 2px;
  }
  .topnav__brand:hover { text-decoration: none; }
  .topnav__brand-mark {
    font-family: var(--font-brand);
    font-weight: 900;
    font-size: 1.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text);
  }
  .topnav__brand-sub {
    font-family: var(--font-brand);
    font-weight: 400;
    font-size: 0.78rem;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding-left: 2px;
  }
  @media (min-width: 720px) {
    .topnav__brand-mark { font-size: 1.85rem; }
  }

  .topnav__desktop { display: none; }
  @media (min-width: 720px) {
    .topnav__desktop { display: flex; align-items: center; gap: var(--space-2); }
    .topnav__ham { display: none !important; }
  }

  .topnav__link {
    color: inherit;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    cursor: pointer;
    list-style: none;
    font-size: 0.95rem;
  }
  .topnav__link::-webkit-details-marker { display: none; }
  .topnav__link:hover { background: var(--color-surface-2); text-decoration: none; }

  .topnav__pill {
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-pill);
    font-weight: 600;
    margin-left: var(--space-3);
    font-size: 0.95rem;
  }
  .topnav__pill:hover { text-decoration: none; background: var(--color-primary-strong); }
  .topnav__pill--full { display: block; text-align: center; margin: 0; }

  .topnav__dd { position: relative; }
  .topnav__dd[open] > .topnav__link { background: var(--color-surface-2); }
  .topnav__menu {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 4px;
    min-width: 260px;
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: 0 12px 28px rgba(44, 58, 78, 0.12);
    padding: var(--space-2);
    display: flex;
    flex-direction: column;
    z-index: 10;
  }
  .topnav__menulink {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    color: var(--color-text);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    font-size: 0.95rem;
  }
  .topnav__menuicon { color: var(--color-primary); flex-shrink: 0; }
  .topnav__menulink:hover { background: var(--color-bg); text-decoration: none; }

  .topnav__ham {
    background: transparent; border: 0; color: inherit;
    width: var(--tap-target); height: var(--tap-target);
    display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px;
  }
  .topnav__ham span { display: block; width: 22px; height: 2px; background: currentColor; }

  .drawer {
    background: var(--color-surface);
    padding: var(--space-3) var(--space-4) var(--space-4);
  }
  .drawer[hidden] { display: none; }
  @media (min-width: 720px) {
    .drawer { display: none !important; }
  }
  .drawer__heading {
    margin: var(--space-3) 0 var(--space-1) 0;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--color-text-muted);
  }
  .drawer__heading:first-child { margin-top: 0; }
  .drawer__list { list-style: none; margin: 0; padding: 0; }
  .drawer__list li a {
    display: block; padding: var(--space-3) var(--space-2); min-height: var(--tap-target);
    color: var(--color-text);
    border-radius: var(--radius);
  }
  .drawer__list li a:hover { background: var(--color-bg); text-decoration: none; }
  .drawer__cta { margin-top: var(--space-4); }
</style>

<script>
  // Sticky nav scroll shadow
  const topnav = document.querySelector('.topnav');
  if (topnav) {
    const setScrolled = () => {
      if (window.scrollY > 4) topnav.classList.add('is-scrolled');
      else topnav.classList.remove('is-scrolled');
    };
    setScrolled();
    window.addEventListener('scroll', setScrolled, { passive: true });
  }

  // Hamburger toggle
  const btn = document.querySelector('.topnav__ham');
  const menu = document.getElementById('sitemenu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const open = !menu.hasAttribute('hidden');
      if (open) {
        menu.setAttribute('hidden', '');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        menu.removeAttribute('hidden');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  }

  // Close Services dropdown when clicking outside
  const dd = document.querySelector('.topnav__dd');
  if (dd) {
    document.addEventListener('click', (e) => {
      if (!dd.contains(e.target as Node)) {
        (dd as HTMLDetailsElement).open = false;
      }
    });
  }
</script>
