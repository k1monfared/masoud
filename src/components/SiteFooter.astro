---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="sitefoot">
  <div class="container sitefoot__inner">
    <div class="sitefoot__brand">
      <p class="sitefoot__name">
        <span class="sitefoot__mark">Manzouri</span>
        <span class="sitefoot__mark-sub" aria-hidden="true">
          <span>I</span><span>M</span><span>M</span><span>I</span><span>G</span><span>R</span><span>A</span><span>T</span><span>I</span><span>O</span><span>N</span>
        </span>
      </p>
      <p class="sitefoot__line">RCIC #{site.rcicLicense} · {site.address.replace('\n', ', ')}</p>
    </div>
    <div class="sitefoot__contact">
      <a href={site.phoneHref}>{site.phone}</a>
      <span class="sitefoot__sep" aria-hidden="true">·</span>
      <a href={site.emailHref}>{site.email}</a>
    </div>
  </div>
  <div class="sitefoot__strip">
    <p>&copy; {year} {site.firmName}. Information on this site is general and not legal advice. Consultations are required for individual case assessments.</p>
  </div>
</footer>

<style>
  .sitefoot {
    background: var(--color-surface);
    color: var(--color-text-muted);
    margin-top: var(--space-7);
    font-size: var(--font-size-sm);
  }
  .sitefoot__inner {
    padding: var(--space-5) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: center;
    text-align: center;
  }
  @media (min-width: 720px) {
    .sitefoot__inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
  .sitefoot__name {
    margin: 0 0 var(--space-2) 0;
    line-height: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    align-items: center;
  }
  @media (min-width: 720px) {
    .sitefoot__name { align-items: flex-start; }
  }
  .sitefoot__mark {
    font-family: var(--font-brand);
    font-weight: 900;
    font-size: 1.1rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text);
    margin-right: -0.18em;
  }
  .sitefoot__mark-sub {
    font-family: var(--font-brand);
    font-weight: 400;
    font-size: 0.7rem;
    text-transform: uppercase;
    color: var(--color-text-muted);
    display: flex;
    justify-content: space-between;
    width: 100%;
  }
  .sitefoot__mark-sub span { display: inline-block; }
  .sitefoot__line { margin: 0; }
  .sitefoot__contact {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
  }
  .sitefoot__contact a {
    color: var(--color-primary);
    font-weight: 600;
  }
  .sitefoot__sep { color: var(--color-text-muted); opacity: 0.5; }
  .sitefoot__strip {
    padding: var(--space-3) var(--space-4) var(--space-5);
    text-align: center;
    font-size: 0.78rem;
  }
  .sitefoot__strip p { margin: 0; max-width: 60ch; margin-left: auto; margin-right: auto; }
</style>
