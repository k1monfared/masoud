---
interface Props {
  eligibilityBullets?: string[];
  processingTime?: string;
  languageRequirement?: string;
  governmentFeeRange?: string;
}
const { eligibilityBullets, processingTime, languageRequirement, governmentFeeRange } = Astro.props;
const hasAny = (eligibilityBullets && eligibilityBullets.length > 0)
  || processingTime || languageRequirement || governmentFeeRange;
---
{hasAny && (
  <aside class="factbox" aria-label="At a glance">
    <h2 class="factbox__title">At a glance</h2>
    {eligibilityBullets && eligibilityBullets.length > 0 && (
      <div class="factbox__row">
        <h3>Eligibility</h3>
        <ul>
          {eligibilityBullets.map(b => <li>{b}</li>)}
        </ul>
      </div>
    )}
    {processingTime && (
      <div class="factbox__row">
        <h3>Processing time</h3>
        <p>{processingTime}</p>
      </div>
    )}
    {languageRequirement && (
      <div class="factbox__row">
        <h3>Language requirement</h3>
        <p>{languageRequirement}</p>
      </div>
    )}
    {governmentFeeRange && (
      <div class="factbox__row">
        <h3>Government fee</h3>
        <p>{governmentFeeRange}</p>
        <p class="factbox__note">Government fees only. Consultation fees are discussed separately.</p>
      </div>
    )}
  </aside>
)}

<style>
  .factbox {
    background: var(--color-surface-2);
    padding: var(--space-4);
    margin: var(--space-4) 0;
  }
  .factbox__title {
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-primary);
    margin: 0 0 var(--space-3) 0;
  }
  .factbox__row { margin: var(--space-3) 0; }
  .factbox__row:first-of-type { margin-top: 0; }
  .factbox__row h3 {
    font-size: var(--font-size-sm);
    color: var(--color-primary);
    margin: 0 0 var(--space-1) 0;
    font-weight: 600;
  }
  .factbox__row p {
    margin: 0;
    color: var(--color-text);
    font-size: var(--font-size-sm);
  }
  .factbox__row ul {
    margin: 0;
    padding-left: 1.2em;
    color: var(--color-text);
    font-size: var(--font-size-sm);
  }
  .factbox__row li { margin: 2px 0; line-height: 1.5; }
  .factbox__note {
    margin-top: var(--space-1) !important;
    color: var(--color-text-muted) !important;
    font-size: 0.78rem !important;
    font-style: italic;
  }
</style>
