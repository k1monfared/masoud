---
import { site } from '../data/site';

interface Props { url?: string; }
const { url } = Astro.props;
const hasUrl = typeof url === 'string' && url.length > 0;
---
{hasUrl ? (
  <div class="cal">
    <iframe
      src={url}
      title="Book a consultation"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allow="camera; microphone; fullscreen"
    ></iframe>
  </div>
) : (
  <div class="cal-fallback">
    {/* TODO(config): set calendarUrl in src/data/site.ts to enable the embedded booking calendar. */}
    <h3 class="cal-fallback__title">Booking calendar coming soon</h3>
    <p class="cal-fallback__body">
      In the meantime, reach out directly. I usually reply within one business day.
    </p>
    <ul class="cal-fallback__list">
      <li><a href={site.phoneHref}>{site.phone}</a></li>
      <li><a href={site.emailHref}>{site.email}</a></li>
    </ul>
  </div>
)}

<style>
  .cal {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 12;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    margin: var(--space-4) 0;
  }
  .cal iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  @media (min-width: 720px) {
    .cal { aspect-ratio: 16 / 9; }
  }

  .cal-fallback {
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-5);
    text-align: center;
    margin: var(--space-4) 0;
  }
  .cal-fallback__title {
    color: var(--color-primary);
    font-size: var(--font-size-lg);
    margin: 0 0 var(--space-2) 0;
  }
  .cal-fallback__body {
    color: var(--color-text-muted);
    margin: 0 auto var(--space-3);
    max-width: 36ch;
  }
  .cal-fallback__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    align-items: center;
  }
  .cal-fallback__list a {
    color: var(--color-primary);
    font-weight: 600;
  }
</style>
