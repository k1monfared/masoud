---
import Icon from './Icon.astro';
interface Props { title: string; slug: string; icon: string; }
const { title, slug, icon } = Astro.props;
---
<a class="goaltile" href={`/${slug}`}>
  <span class="goaltile__icon" aria-hidden="true"><Icon name={icon} size={32} strokeWidth={1.4} /></span>
  <span class="goaltile__title">{title}</span>
  <span class="goaltile__more">Learn more</span>
</a>

<style>
  .goaltile {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: var(--space-2);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    text-align: center;
    padding: var(--space-5) var(--space-3);
    min-height: 140px;
    transition: background 150ms ease;
  }
  .goaltile:hover {
    text-decoration: none;
    background: var(--color-surface-2);
  }
  .goaltile__icon {
    color: var(--color-primary);
    line-height: 1;
    margin-bottom: var(--space-2);
    display: inline-flex;
  }
  .goaltile__title {
    font-weight: 700;
    color: var(--color-text);
    font-size: 1rem;
    letter-spacing: 0.01em;
  }
  .goaltile__more {
    color: var(--color-primary);
    font-size: var(--font-size-sm);
    font-weight: 600;
    margin-top: var(--space-1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
</style>
