---
import Icon from './Icon.astro';
import { path } from '../lib/path';
interface Props { title: string; slug: string; icon: string; image?: string; }
const { title, slug, icon, image } = Astro.props;
const styleAttr = image ? `--tile-image: url('${image}')` : undefined;
---
<a class={`goaltile${image ? ' goaltile--photo' : ''}`} href={path(`/${slug}`)} style={styleAttr}>
  <div class="goaltile__card">
    <span class="goaltile__icon" aria-hidden="true"><Icon name={icon} size={20} strokeWidth={1.6} /></span>
    <span class="goaltile__title">{title}</span>
    <span class="goaltile__chev" aria-hidden="true"><Icon name="chevron-right" size={16} strokeWidth={2} /></span>
  </div>
</a>

<style>
  .goaltile {
    position: relative;
    display: block;
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    min-height: 64px;
  }
  .goaltile:hover { text-decoration: none; }

  .goaltile--photo {
    background-image: var(--tile-image);
    background-size: cover;
    background-position: center;
  }

  .goaltile__card {
    position: relative;
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(10px) saturate(1.15);
    -webkit-backdrop-filter: blur(10px) saturate(1.15);
    padding: var(--space-3) var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 64px;
    transition: background 200ms ease, transform 250ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .goaltile:hover .goaltile__card {
    background: rgba(255, 255, 255, 0.92);
  }

  .goaltile__icon {
    color: var(--color-primary);
    line-height: 1;
    display: inline-flex;
    flex-shrink: 0;
  }
  .goaltile__title {
    flex: 1;
    font-weight: 700;
    color: var(--color-text);
    font-size: 1rem;
    letter-spacing: 0;
    line-height: 1.25;
    min-width: 0;
  }
  .goaltile__chev {
    color: var(--color-text-muted);
    line-height: 1;
    display: inline-flex;
    flex-shrink: 0;
  }

  @media (min-width: 720px) {
    .goaltile {
      min-height: 240px;
    }
    .goaltile__card {
      position: absolute;
      left: var(--space-3);
      right: var(--space-3);
      bottom: var(--space-3);
      background: rgba(255, 255, 255, 0.65);
      box-shadow: 0 4px 14px rgba(20, 48, 77, 0.16);
      min-height: auto;
    }
    .goaltile:hover .goaltile__card {
      transform: translateY(-6px);
      box-shadow: 0 10px 22px rgba(20, 48, 77, 0.22);
      background: rgba(255, 255, 255, 0.82);
    }
    .goaltile__title {
      font-size: clamp(0.85rem, 1.6vw, 1.05rem);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .goaltile__chev { display: none; }
  }
</style>
