---
import Icon from './Icon.astro';
import { path } from '../lib/path';
interface Props { title: string; slug: string; icon: string; image?: string; }
const { title, slug, icon, image } = Astro.props;
const styleAttr = image ? `--tile-image: url('${image}')` : undefined;
---
<a class={`goaltile${image ? ' goaltile--photo' : ''}`} href={path(`/${slug}`)} style={styleAttr}>
  <div class="goaltile__card">
    <span class="goaltile__icon" aria-hidden="true"><Icon name={icon} size={24} strokeWidth={1.6} /></span>
    <span class="goaltile__title">{title}</span>
  </div>
</a>

<style>
  .goaltile {
    position: relative;
    display: block;
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    min-height: 200px;
    overflow: hidden;
    isolation: isolate;
  }
  .goaltile:hover { text-decoration: none; }

  .goaltile--photo {
    background-image: var(--tile-image);
    background-size: cover;
    background-position: center;
    min-height: 240px;
  }

  .goaltile__card {
    position: absolute;
    left: var(--space-4);
    right: var(--space-4);
    bottom: var(--space-4);
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(12px) saturate(1.15);
    -webkit-backdrop-filter: blur(12px) saturate(1.15);
    padding: var(--space-3) var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    box-shadow: 0 4px 14px rgba(20, 48, 77, 0.16);
    transition: transform 250ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 250ms ease, background 250ms ease;
  }
  .goaltile:hover .goaltile__card {
    transform: translateY(-6px);
    box-shadow: 0 10px 22px rgba(20, 48, 77, 0.22);
    background: rgba(255, 255, 255, 0.82);
  }

  .goaltile__icon {
    color: var(--color-primary);
    line-height: 1;
    display: inline-flex;
    flex-shrink: 0;
  }
  .goaltile__title {
    font-weight: 700;
    color: var(--color-text);
    font-size: 1.2rem;
    letter-spacing: 0.01em;
    line-height: 1.25;
  }
</style>
