---
import Icon from './Icon.astro';
import { path } from '../lib/path';
interface Props { title: string; slug: string; icon: string; image?: string; }
const { title, slug, icon, image } = Astro.props;
const styleAttr = image ? `--tile-image: url('${image}')` : undefined;
---
<a class={`goaltile${image ? ' goaltile--photo' : ''}`} href={path(`/${slug}`)} style={styleAttr}>
  <span class="goaltile__inner">
    <span class="goaltile__icon" aria-hidden="true"><Icon name={icon} size={32} strokeWidth={1.6} /></span>
    <span class="goaltile__title">{title}</span>
  </span>
</a>

<style>
  .goaltile {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    text-align: center;
    padding: var(--space-6) var(--space-3);
    min-height: 200px;
    overflow: hidden;
    isolation: isolate;
  }
  .goaltile:hover { text-decoration: none; }

  .goaltile--photo {
    color: #fff;
    background-image: var(--tile-image);
    background-size: cover;
    background-position: center;
    min-height: 240px;
  }

  .goaltile__inner {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    transition: transform 250ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .goaltile:hover .goaltile__inner {
    transform: translateY(-6px);
  }

  .goaltile__icon {
    color: var(--color-primary);
    line-height: 1;
    display: inline-flex;
  }
  .goaltile--photo .goaltile__icon {
    color: #fff;
    filter:
      drop-shadow(0 0 1px rgba(0, 0, 0, 1))
      drop-shadow(0 0 2px rgba(0, 0, 0, 0.85))
      drop-shadow(0 1px 3px rgba(0, 0, 0, 0.5));
  }
  .goaltile__title {
    font-weight: 700;
    color: inherit;
    font-size: 1.05rem;
    letter-spacing: 0.01em;
  }
  .goaltile--photo .goaltile__title {
    font-size: 1.25rem;
    -webkit-text-stroke: 2px rgba(0, 0, 0, 0.9);
    paint-order: stroke fill;
  }
</style>
