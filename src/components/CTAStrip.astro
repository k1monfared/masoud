---
import { bookingHref } from '../data/site';
---
{/* TODO(copy): tweak strip wording. */}
<section class="ctastrip">
  <div class="ctastrip__inner">
    <h2 class="ctastrip__heading">Not sure where to start?</h2>
    <p class="ctastrip__body">Book a free 30-minute call. We talk through where you are, where you want to go, and the realistic paths in between.</p>
    <a class="ctastrip__btn" href={bookingHref}>Book free consultation</a>
  </div>
</section>

<style>
  .ctastrip {
    margin: var(--space-7) calc(var(--space-4) * -1) 0;
    padding: var(--space-7) var(--space-4);
    background: var(--color-surface-2);
    border-top: 1px solid var(--color-border);
    text-align: center;
  }
  .ctastrip__inner {
    max-width: var(--content-width);
    margin: 0 auto;
  }
  .ctastrip__heading {
    font-size: 1.75rem;
    color: var(--color-text);
    margin: 0 0 var(--space-3) 0;
    font-weight: 600;
  }
  .ctastrip__body {
    margin: 0 auto var(--space-4);
    max-width: 44ch;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .ctastrip__btn {
    display: inline-flex;
    align-items: center;
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-pill);
    font-weight: 600;
    min-height: var(--tap-target);
    box-shadow: 0 4px 12px rgba(168, 118, 72, 0.25);
  }
  .ctastrip__btn:hover { text-decoration: none; background: var(--color-primary-strong); }
</style>
