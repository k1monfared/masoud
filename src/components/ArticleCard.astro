---
interface Props {
  title: string;
  href: string;
  date: Date;
  summary: string;
  tag?: string;
}
const { title, href, date, summary, tag } = Astro.props;
const formatted = date.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' });
---
<a class="article" href={href}>
  <div class="article__meta">
    <time datetime={date.toISOString()}>{formatted}</time>
    {tag && <span class="article__tag">{tag}</span>}
  </div>
  <h3 class="article__title">{title}</h3>
  <p class="article__summary">{summary}</p>
  <span class="article__more">Read more →</span>
</a>

<style>
  .article {
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-4);
    color: var(--color-text);
    margin: var(--space-2) 0;
  }
  .article:hover { text-decoration: none; border-color: var(--color-primary); }
  .article__meta {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    margin-bottom: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
  .article__tag {
    background: var(--color-surface-2);
    color: var(--color-primary);
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .article__title {
    font-size: var(--font-size-lg);
    color: var(--color-primary);
    margin: 0 0 var(--space-2) 0;
  }
  .article__summary {
    margin: 0 0 var(--space-3) 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: 1.5;
  }
  .article__more {
    color: var(--color-primary);
    font-weight: 600;
    font-size: var(--font-size-sm);
  }
</style>
