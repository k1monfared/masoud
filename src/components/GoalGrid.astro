---
import { getCollection } from 'astro:content';
import GoalTile from './GoalTile.astro';
const goals = (await getCollection('goals')).sort((a, b) => a.data.order - b.data.order);
---
<section class="goalgrid">
  <div class="goalgrid__tiles">
    {goals.map(g => (
      <GoalTile title={g.data.title} slug={g.slug} icon={g.data.icon} image={g.data.image} />
    ))}
  </div>
</section>

<style>
  .goalgrid { margin: 0; }
  .goalgrid__tiles {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    max-width: 960px;
    margin: 0 auto;
  }
  @media (min-width: 720px) {
    .goalgrid__tiles { grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  }
</style>
