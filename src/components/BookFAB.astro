---
import Icon from './Icon.astro';
import { bookingHref } from '../data/site';
---
<a class="bookfab" href={bookingHref} aria-label="Book a free consultation" transition:persist>
  <span class="bookfab__icon" aria-hidden="true"><Icon name="calendar" size={22} strokeWidth={1.8} /></span>
  <span class="bookfab__label">Book a free consultation</span>
</a>

<style>
  .bookfab {
    position: fixed;
    right: calc(var(--space-4) + env(safe-area-inset-right, 0px));
    bottom: calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
    z-index: 80;
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: 0 var(--space-5);
    height: 56px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 8px 22px rgba(217, 119, 78, 0.4);
    white-space: nowrap;
    border-radius: var(--radius);
    overflow: hidden;
    cursor: pointer;
    transition: background 200ms ease, opacity 200ms ease;
  }
  @media (min-width: 720px) {
    .bookfab {
      right: calc(var(--space-6) + env(safe-area-inset-right, 0px));
      bottom: calc(var(--space-6) + env(safe-area-inset-bottom, 0px));
    }
  }
  .bookfab:hover { text-decoration: none; background: var(--color-primary-strong); }
  .bookfab:active { transform: scale(0.97); }
  .bookfab__icon { display: inline-flex; flex-shrink: 0; pointer-events: none; }
  .bookfab__label { display: inline-block; max-width: 240px; overflow: hidden; pointer-events: none; }

  body.is-menu-open .bookfab { opacity: 0; pointer-events: none; }

  @media (max-width: 719px) {
    .bookfab {
      animation: bookfab-collapse 700ms cubic-bezier(0.2, 0.8, 0.2, 1) 2200ms forwards;
    }
    .bookfab__label {
      animation: bookfab-label-fade 500ms ease 2200ms forwards;
    }
    @keyframes bookfab-collapse {
      to {
        width: 56px;
        min-width: 56px;
        padding: 0;
        gap: 0;
        border-radius: 14px;
      }
    }
    @keyframes bookfab-label-fade {
      from { max-width: 240px; opacity: 1; }
      to { max-width: 0; opacity: 0; }
    }
  }
</style>
