---
import Icon from './Icon.astro';
import { bookingHref } from '../data/site';
---
<a class="bookfab" href={bookingHref} aria-label="Book a consultation">
  <span class="bookfab__icon" aria-hidden="true"><Icon name="calendar" size={22} strokeWidth={1.8} /></span>
  <span class="bookfab__label">Book consultation</span>
</a>

<style>
  .bookfab {
    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 60;
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: 0 var(--space-5);
    height: 56px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 8px 22px rgba(217, 119, 78, 0.4);
    transition:
      width 380ms cubic-bezier(0.2, 0.8, 0.2, 1),
      max-width 380ms cubic-bezier(0.2, 0.8, 0.2, 1),
      padding 380ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-radius 380ms cubic-bezier(0.2, 0.8, 0.2, 1),
      gap 380ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background 200ms ease,
      opacity 200ms ease;
    overflow: hidden;
    white-space: nowrap;
    border-radius: 0;
  }
  .bookfab:hover { text-decoration: none; background: var(--color-primary-strong); }
  .bookfab__icon { display: inline-flex; flex-shrink: 0; }
  .bookfab__label { display: inline-flex; }

  /* Hide while mobile drawer is open */
  body.is-menu-open .bookfab {
    opacity: 0;
    pointer-events: none;
  }

  /* Mobile: collapses to a heavy-rounded square (FAB) */
  @media (max-width: 719px) {
    .bookfab--compact {
      width: 56px;
      max-width: 56px;
      padding: 0;
      gap: 0;
      border-radius: 28px;
    }
    .bookfab--compact .bookfab__label {
      width: 0;
      opacity: 0;
      pointer-events: none;
    }
  }

  /* Tiny entry animation */
  .bookfab--enter {
    animation: bookfab-pop 360ms cubic-bezier(0.2, 0.9, 0.2, 1) both;
  }
  @keyframes bookfab-pop {
    from { transform: scale(0.6) translateY(20px); opacity: 0; }
    to { transform: scale(1) translateY(0); opacity: 1; }
  }
</style>

<script>
  const fab = document.querySelector('.bookfab') as HTMLElement | null;
  if (fab) {
    const isMobile = () => window.matchMedia('(max-width: 719px)').matches;
    const STORAGE_KEY = 'manzouri:bookfab:seen';

    fab.classList.add('bookfab--enter');
    fab.addEventListener('animationend', () => fab.classList.remove('bookfab--enter'), { once: true });

    if (isMobile()) {
      const seen = (() => {
        try { return localStorage.getItem(STORAGE_KEY) === '1'; }
        catch { return false; }
      })();

      if (seen) {
        // Skip the intro: jump straight to compact, no transition.
        const prevTransition = fab.style.transition;
        fab.style.transition = 'none';
        fab.classList.add('bookfab--compact');
        // Force reflow, then restore transitions.
        void fab.offsetWidth;
        fab.style.transition = prevTransition;
      } else {
        // First visit: show the full pill, then collapse after a beat.
        window.setTimeout(() => {
          fab.classList.add('bookfab--compact');
          try { localStorage.setItem(STORAGE_KEY, '1'); } catch {}
        }, 2200);
      }
    }

    // If the viewport flips between mobile/desktop during the session, sync state.
    window.addEventListener('resize', () => {
      if (!isMobile()) {
        fab.classList.remove('bookfab--compact');
      } else {
        try {
          if (localStorage.getItem(STORAGE_KEY) === '1') {
            fab.classList.add('bookfab--compact');
          }
        } catch {}
      }
    });
  }
</script>
