---
import Icon from './Icon.astro';
import { bookingHref } from '../data/site';
---
<a class="bookfab" href={bookingHref} aria-label="Book a consultation">
  <span class="bookfab__icon" aria-hidden="true"><Icon name="calendar" size={22} strokeWidth={1.8} /></span>
  <span class="bookfab__label">Book consultation</span>
</a>

<style>
  .bookfab {
    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 60;
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: 0 var(--space-5);
    height: 56px;
    max-width: 320px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 8px 22px rgba(217, 119, 78, 0.4);
    overflow: hidden;
    white-space: nowrap;
    border-radius: var(--radius);
    transition:
      max-width 380ms cubic-bezier(0.2, 0.8, 0.2, 1),
      padding 380ms cubic-bezier(0.2, 0.8, 0.2, 1),
      gap 380ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-radius 380ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background 200ms ease,
      opacity 200ms ease;
  }
  @media (min-width: 720px) {
    .bookfab { right: var(--space-6); bottom: var(--space-6); }
  }
  .bookfab:hover { text-decoration: none; background: var(--color-primary-strong); }
  .bookfab__icon { display: inline-flex; flex-shrink: 0; }
  .bookfab__label { display: inline-block; transition: max-width 380ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 280ms ease; max-width: 220px; overflow: hidden; }

  /* Hide while mobile drawer is open */
  body.is-menu-open .bookfab {
    opacity: 0;
    pointer-events: none;
  }

  /* Mobile compact form: small rounded square, icon only */
  @media (max-width: 719px) {
    .bookfab--compact {
      max-width: 56px;
      padding: 0;
      gap: 0;
      border-radius: 28px;
    }
    .bookfab--compact .bookfab__label {
      max-width: 0;
      opacity: 0;
      pointer-events: none;
    }
  }

  /* First-visit pop entry */
  .bookfab--enter {
    animation: bookfab-pop 360ms cubic-bezier(0.2, 0.9, 0.2, 1) both;
  }
  @keyframes bookfab-pop {
    from { transform: scale(0.6) translateY(20px); opacity: 0; }
    to { transform: scale(1) translateY(0); opacity: 1; }
  }
</style>

<script is:inline>
  (function () {
    var STORAGE_KEY = 'manzouri:bookfab:seen';

    function isMobile() {
      return window.matchMedia('(max-width: 719px)').matches;
    }
    function readSeen() {
      try { return localStorage.getItem(STORAGE_KEY) === '1'; } catch (e) { return false; }
    }
    function markSeen() {
      try { localStorage.setItem(STORAGE_KEY, '1'); } catch (e) {}
    }

    function setup() {
      var fab = document.querySelector('.bookfab');
      if (!fab) return;

      // Pop animation on entry
      fab.classList.add('bookfab--enter');
      fab.addEventListener('animationend', function handler() {
        fab.classList.remove('bookfab--enter');
        fab.removeEventListener('animationend', handler);
      });

      if (isMobile()) {
        if (readSeen()) {
          // Seen before: skip the intro, jump straight to compact, no transition
          var prev = fab.style.transition;
          var prevLabel = fab.querySelector('.bookfab__label');
          var prevLabelTransition = prevLabel ? prevLabel.style.transition : null;
          fab.style.transition = 'none';
          if (prevLabel) prevLabel.style.transition = 'none';
          fab.classList.add('bookfab--compact');
          // force reflow then restore
          void fab.offsetWidth;
          fab.style.transition = prev || '';
          if (prevLabel) prevLabel.style.transition = prevLabelTransition || '';
        } else {
          // First visit: show full, then collapse after a beat
          window.setTimeout(function () {
            fab.classList.add('bookfab--compact');
            markSeen();
          }, 2200);
        }
      } else {
        fab.classList.remove('bookfab--compact');
      }
    }

    function onResize() {
      var fab = document.querySelector('.bookfab');
      if (!fab) return;
      if (!isMobile()) {
        fab.classList.remove('bookfab--compact');
      } else if (readSeen()) {
        fab.classList.add('bookfab--compact');
      }
    }

    document.addEventListener('astro:page-load', setup);
    if (document.readyState !== 'loading') setup();
    else document.addEventListener('DOMContentLoaded', setup);

    window.addEventListener('resize', onResize);
  })();
</script>
