---
import BaseLayout from '../layouts/BaseLayout.astro';
import BackLink from '../components/BackLink.astro';
import ConsultationCTA from '../components/ConsultationCTA.astro';
import { site } from '../data/site';
---
{/* TODO(copy): rewrite the entire About narrative in your own voice. */}
<BaseLayout title={`About ${site.practitionerName} | ${site.firmName}`}>
  <BackLink href="/" label="Home" />

  <section class="about__hero">
    <div class="about__photo" aria-hidden="true">
      <span>Photo</span>
    </div>
    <div>
      <h1>{site.practitionerName}</h1>
      <p class="about__role">Regulated Canadian Immigration Consultant. License #{site.rcicLicense}.</p>
      <p class="about__role about__role--muted">{site.yearsExperience}+ years. {site.clientsServed}+ clients guided.</p>
    </div>
  </section>

  <section class="about__section">
    <h2>My story</h2>
    <p>
      I came to this work through my own family's move to Canada. The forms looked like a wall. The terminology felt invented to keep people out. I learned the system because I needed to, then realized other families needed the same map I'd had to build by hand.
    </p>
    <p>
      I became a Regulated Canadian Immigration Consultant so I could give that map to other people, in plain language, with the time to actually answer questions.
    </p>
    <p>
      My practice is small and personal. I take on the cases I can do well. If your situation is outside my expertise, I will tell you on the first call and refer you to someone better suited.
    </p>
  </section>

  <section class="about__section">
    <h2>Credentials and memberships</h2>
    <ul>
      <li>Regulated Canadian Immigration Consultant (RCIC), License #{site.rcicLicense}</li>
      <li>Member, College of Immigration and Citizenship Consultants</li>
      <li>Continuing professional development completed annually</li>
    </ul>
  </section>

  <section class="about__section">
    <h2>Languages I work in</h2>
    <p>{site.languages.join(', ')}. I use the language you think in, not the one the form is printed in.</p>
  </section>

  <section class="about__section">
    <h2>How I work</h2>
    <div class="about__principles">
      <article class="principle">
        <h3>Free first call</h3>
        <p>Thirty minutes, no obligation. We figure out where you stand and which paths fit, and you decide whether to keep working with me.</p>
      </article>
      <article class="principle">
        <h3>Transparent fees</h3>
        <p>Flat fees agreed in writing before any work begins. No surprises, no hourly clock running while you ask questions.</p>
      </article>
      <article class="principle">
        <h3>Plain English</h3>
        <p>I explain the rules and your options without jargon. You leave each meeting knowing what just happened and what comes next.</p>
      </article>
    </div>
  </section>

  <ConsultationCTA />
</BaseLayout>

<style>
  h1 {
    font-size: var(--font-size-2xl);
    color: var(--color-primary);
    margin: 0 0 var(--space-1) 0;
  }
  h2 {
    font-size: var(--font-size-lg);
    color: var(--color-primary);
    margin: 0 0 var(--space-3) 0;
  }
  .about__hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: var(--space-3) 0 var(--space-6);
    align-items: flex-start;
  }
  @media (min-width: 720px) {
    .about__hero { flex-direction: row; align-items: center; gap: var(--space-5); }
  }
  .about__photo {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: var(--color-surface-2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    border: 1px solid var(--color-border);
    flex-shrink: 0;
  }
  .about__role { margin: var(--space-1) 0; color: var(--color-text); }
  .about__role--muted { color: var(--color-text-muted); font-size: var(--font-size-sm); }

  .about__section { margin: var(--space-6) 0; }
  .about__section p { line-height: 1.6; margin: var(--space-2) 0; }
  .about__section ul { padding-left: 1.2em; margin: 0; }
  .about__section li { margin: var(--space-1) 0; line-height: 1.6; }

  .about__principles {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  @media (min-width: 720px) {
    .about__principles { grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  }
  .principle {
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
  }
  .principle h3 {
    font-size: var(--font-size-base);
    color: var(--color-primary);
    margin: 0 0 var(--space-2) 0;
  }
  .principle p { margin: 0; font-size: var(--font-size-sm); color: var(--color-text-muted); line-height: 1.5; }
</style>
