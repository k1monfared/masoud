---
import BaseLayout from '../layouts/BaseLayout.astro';
import BackLink from '../components/BackLink.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { path } from '../lib/path';
---
{/* TODO(copy): rewrite the entire About narrative in your own voice. */}
<BaseLayout title={`About ${site.practitionerName} | ${site.firmName}`}>
  <BackLink href={path('/')} label="Home" />

  <div class="about__layout">
    <div class="about__main">
      <header class="about__hero">
        <h1>{site.practitionerName}</h1>
        <p class="about__role">Regulated Canadian Immigration Consultant. RCIC #{site.rcicLicense}.</p>
      </header>

      <section class="about__section">
        <h2>Trusted Canadian immigration consulting</h2>
        <p class="about__lead">{site.aboutBlurb}</p>
      </section>

      <section class="about__section">
        <h2>My story</h2>
        <p>
          I came to this work through my own family's move to Canada. The forms looked like a wall. The terminology felt invented to keep people out. I learned the system because I needed to, then realized other families needed the same map I'd had to build by hand.
        </p>
        <p>
          I became a Regulated Canadian Immigration Consultant so I could give that map to other people, in plain language, with the time to actually answer questions.
        </p>
        <p>
          My practice is small and personal. I take on the cases I can do well. If your situation is outside my expertise, I will tell you on the first call and refer you to someone better suited.
        </p>
      </section>
    </div>

    <aside class="about__aside">
      <img class="about__photo" src={path('/images/practitioner.png')} alt={`${site.practitionerName}, ${site.firmName}`} loading="eager" />

      <section class="about__sidebar-section">
        <p class="about__sidebar-eyebrow">Credentials</p>
        <ul class="about__credentials">
          {site.credentials.map(c => (
            <li>
              <Icon name="check" size={16} strokeWidth={2} class="about__credentials-check" />
              <span>{c.url ? <a href={c.url} target="_blank" rel="noopener">{c.label}</a> : c.label}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="about__sidebar-section">
        <p class="about__sidebar-eyebrow">Languages</p>
        <p class="about__languages">{site.languages.join(', ')}.</p>
        <p class="about__languages-note">I use the language you think in, not the one the form is printed in.</p>
      </section>
    </aside>
  </div>

  <section class="about__why">
    <h2>Why work with me</h2>
    <div class="about__principles">
      <article class="principle">
        <h3>Free first call</h3>
        <p>Thirty minutes, no obligation. We figure out where you stand and which paths fit, and you decide whether to keep working with me.</p>
      </article>
      <article class="principle">
        <h3>Transparent fees</h3>
        <p>Flat fees agreed in writing before any work begins. No surprises, no hourly clock running while you ask questions.</p>
      </article>
      <article class="principle">
        <h3>Plain English</h3>
        <p>I explain the rules and your options without jargon. You leave each meeting knowing what just happened and what comes next.</p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    color: var(--color-text);
    margin: 0 0 var(--space-2) 0;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  h2 {
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    color: var(--color-text);
    margin: 0 0 var(--space-3) 0;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .about__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    margin: var(--space-4) 0 var(--space-7);
  }
  @media (min-width: 720px) {
    .about__layout {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: var(--space-7);
      align-items: start;
    }
  }

  .about__aside {
    order: -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }
  @media (min-width: 720px) {
    .about__aside { order: 0; align-items: stretch; }
  }

  .about__photo {
    width: 240px;
    height: auto;
    display: block;
    margin: 0 auto;
    mask-image: linear-gradient(180deg, #000 0%, #000 90%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 90%, transparent 100%);
  }
  @media (min-width: 720px) {
    .about__photo { width: 100%; max-width: 320px; margin: 0 auto; }
  }

  .about__sidebar-section { width: 100%; max-width: 480px; margin: 0 auto; }
  @media (min-width: 720px) {
    .about__sidebar-section { margin: 0; }
  }
  .about__sidebar-eyebrow {
    color: var(--color-primary);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 700;
    margin: 0 0 var(--space-3) 0;
  }
  .about__credentials {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .about__credentials li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text);
  }
  .about__credentials-check { color: var(--color-primary); flex-shrink: 0; margin-top: 3px; }
  .about__credentials a { color: var(--color-text); }
  .about__credentials a:hover { color: var(--color-primary); text-decoration: underline; }

  .about__languages {
    margin: 0 0 var(--space-2) 0;
    color: var(--color-text);
    font-weight: 700;
    font-size: 1rem;
  }
  .about__languages-note {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .about__hero { margin: 0 0 var(--space-6) 0; }
  .about__role {
    margin: var(--space-2) 0 0 0;
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  .about__section { margin: var(--space-6) 0; }
  .about__section p { line-height: 1.7; margin: var(--space-3) 0; }
  .about__lead { font-size: 1.1rem; color: var(--color-text); }

  .about__why {
    margin: var(--space-7) 0;
  }
  .about__principles {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  @media (min-width: 720px) {
    .about__principles { grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  }
  .principle {
    background: var(--color-surface);
    padding: var(--space-5) var(--space-4);
  }
  .principle h3 {
    font-size: 1.1rem;
    color: var(--color-text);
    margin: 0 0 var(--space-2) 0;
    font-weight: 700;
  }
  .principle p { margin: 0; font-size: var(--font-size-sm); color: var(--color-text-muted); line-height: 1.6; }
</style>
